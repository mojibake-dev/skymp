// yarn test: every test/**/*.test.ts, compiled with the modules it imports
// into build/test and run there by Node's own test runner (node --test finds
// test/*.test.js under its working directory). The skyrimPlatform path is
// mapped for its types alone, so a test that reaches a service (its type
// import compiles the service and what it imports) loads the platform's
// stand-in under that name itself (test/shoutClaimUpdate.test.ts); a pure
// module's test needs none.
{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["esnext"],
    "baseUrl": ".",
    "paths": { "skyrimPlatform": ["node_modules/@skyrim-platform/skyrim-platform"] },
    "rootDir": ".",
    "outDir": "build/test"
  },
  "include": ["test/**/*.test.ts"]
}
